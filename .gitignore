.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
logs/
error_log
access_log

# Temporary files
tmp/
temp/
cache/

# Backup files
*.bak
*.backup
*.old
*~

# Composer (if used)
/vendor/
composer.lock

# Node modules (if used)
node_modules/
package-lock.json
yarn.lock

# Build files (if used)
dist/
build/

# Upload directories (if needed)
uploads/

